# Copy this file to docker/.env and fill in the values.
# docker compose automatically loads docker/.env when run from the docker/ directory.
#
#   cp docker/.env.example docker/.env
#   # edit docker/.env
#   docker compose -f docker/docker-compose.yaml up

# HuggingFace model id (or local path) to serve.
MODEL=Tongyi-MAI/Z-Image-Turbo

# Optional: HuggingFace token for gated/private models.
HF_TOKEN=

# Optional: extra CLI flags appended to `vllm serve --omni <MODEL> --port 8080`.
# Example for Qwen-Drive FP8:
# EXTRA_ARGS=--deploy-config vllm_omni/deploy/qwen_drive_fp8.yaml
EXTRA_ARGS=
